{
  "extends": "expo/tsconfig",
  "compilerOptions": {
    "strict": true, 
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@services/*": ["src/services/*"],
      "@utils/*": ["src/utils/*"],
      "@context/*": ["src/context/*"]
    }
  },
  "exclude": ["supabase/functions"]
}
