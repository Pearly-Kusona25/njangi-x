{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "typeRoots": ["./types"]
  },
  "include": ["**/*.ts"]
}
